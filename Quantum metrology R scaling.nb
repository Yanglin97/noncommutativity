   RowBox[{
    RowBox[{"ClearAll", "[", "\n", "  ", 
     RowBox[{
     "CheckOddDimension", ",", "\n", "  ", "Labels", ",", "\n", "  ", 
      "CanonicalLabel", ",", "\n", "  ", "DGWFourierMatrixXToP", ",", "\n", 
      "  ", "DGWStateVectorXBasis"}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
