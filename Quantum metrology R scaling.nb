  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\n", "  ", 
     RowBox[{
     "OddDimensionAtLeast", ",", "\n", "  ", "DGWScalingCache", ",", "\n", 
      "  ", "MakeConjugateScalingInstance", ",", "\n", "  ", 
      "FastMSEForScalingInstance", ",", "\n", "  ", "AnalyzeScalingInstance", 
      ",", "\n", "  ", "FitLogLogData", ",", "\n", "  ", 
      "RunVariableNCoefficientStudy", ",", "\n", "  ", 
      "RunFixedD65CoefficientStudy", ",", "\n", "  ", 
      "RunQuadraticDimensionCoefficientStudy"}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"OddDimensionAtLeast", "[", 
      RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"Ceiling", "[", "x", "]"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OddQ", "[", "d", "]"}], ",", " ", "d", ",", " ", 
         RowBox[{"d", " ", "+", " ", "1"}]}], "]"}]}], "\n", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Quantities", " ", "depending", " ", "only", " ", "on", " ", 
     RowBox[{"d", ".", " ", "The"}], " ", "memoization", " ", "avoids", " ", 
     "rebuilding", " ", "the", "\n", "   ", "Fourier", " ", "matrix", " ", 
     "and", " ", "DGW", " ", "state", " ", "for", " ", "every", " ", "random",
      " ", "displacement", " ", 
     RowBox[{"instance", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"DGWScalingCache", "[", 
       RowBox[{"d_Integer", "?", "Positive"}], "]"}], " ", "/;", " ", 
      RowBox[{"OddQ", "[", "d", "]"}]}], " ", ":=", "\n", "  ", 
     RowBox[{
      RowBox[{"DGWScalingCache", "[", "d", "]"}], " ", "=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "labels", ",", " ", "scale", ",", " ", "fourier", ",", " ", "psi", ",",
           " ", "q", ",", " ", "psiMomentum", ",", " ", "energy"}], "}"}], ",",
         "\n", "    ", 
        RowBox[{
         RowBox[{"labels", " ", "=", " ", 
          RowBox[{"Labels", "[", "d", "]"}]}], ";", "\n", "    ", 
         RowBox[{"scale", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", 
            RowBox[{"Pi", "/", "d"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"fourier", " ", "=", " ", 
          RowBox[{"DGWFourierMatrixXToP", "[", "d", "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{"psi", " ", "=", " ", 
          RowBox[{"DGWStateVectorXBasis", "[", 
           RowBox[{"d", ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"Sqrt", "[", "d", "]"}], "]"}], ",", " ", "0.", ",", " ",
             "0."}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"q", " ", "=", " ", 
          RowBox[{"N", "[", 
           RowBox[{"scale", " ", "labels"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"psiMomentum", " ", "=", " ", 
          RowBox[{"fourier", " ", ".", " ", "psi"}]}], ";", "\n", "    ", 
         RowBox[{"energy", " ", "=", " ", 
          RowBox[{"Chop", "[", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "psi", "]"}], "^", "2"}], " ", 
              RowBox[{"q", "^", "2"}]}], "]"}], " ", "+", " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "psiMomentum", "]"}], "^", "2"}], " ", 
              RowBox[{"q", "^", "2"}]}], "]"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"<|", "\n", "      ", 
          RowBox[{
           RowBox[{"\"\<d\>\"", " ", "->", " ", "d"}], ",", "\n", "      ", 
           RowBox[{"\"\<Labels\>\"", " ", "->", " ", "labels"}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<Scale\>\"", " ", "->", " ", "scale"}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<Fourier\>\"", " ", "->", " ", "fourier"}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<ProbeState\>\"", " ", "->", " ", "psi"}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<QuadratureEigenvalues\>\"", " ", "->", " ", "q"}], ",",
            "\n", "      ", 
           RowBox[{"\"\<ProbeEnergy\>\"", " ", "->", " ", 
            RowBox[{"N", "[", 
             RowBox[{"Re", "[", "energy", "]"}], "]"}]}]}], "\n", "    ", 
          "|>"}]}]}], "\n", "  ", "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Exact", " ", "fast", " ", "simulation", " ", "for", " ", "the", " ", 
       "conjugate", " ", "family", " ", "alpha_j"}], " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"p_j", ",", "0"}], "}"}]}], ",", " ", 
     RowBox[{"beta_j", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "x_j"}], "}"}], ".", " ", "It"}], " ", 
       "propagates", " ", "the", " ", "two", " ", "branch", " ", "states", " ",
        "directly"}]}], ",", " ", 
     RowBox[{
      RowBox[{"without", " ", "constructing", " ", "a", " ", "2", "d"}], "-", 
      RowBox[{"dimensional", " ", "controlled"}], "-", 
      RowBox[{"switch", " ", 
       RowBox[{"matrix", "."}]}]}]}], " ", "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"MakeConjugateScalingInstance", "[", 
       RowBox[{
        RowBox[{"d_Integer", "?", "Positive"}], ",", 
        RowBox[{"n_Integer", "?", "Positive"}], ",", "\[IndentingNewLine]", 
        RowBox[{"pRange", ":", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"_", "?", "NumericQ"}], ",", " ", 
           RowBox[{"_", "?", "NumericQ"}]}], "}"}]}], ",", 
        RowBox[{"xRange", ":", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"_", "?", "NumericQ"}], ",", " ", 
           RowBox[{"_", "?", "NumericQ"}]}], "}"}]}]}], "\[IndentingNewLine]",
        "]"}], " ", "/;", " ", 
      RowBox[{"OddQ", "[", "d", "]"}]}], " ", ":=", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "cache", ",", " ", "fourier", ",", " ", "psi", ",", " ", "q", ",", 
         " ", "energy", ",", " ", "pValues", ",", " ", "xValues", ",", 
         "pTotal", ",", " ", "xTotal", ",", " ", "phaseAlpha", ",", " ", 
         "phaseBeta", ",", " ", "applyBeta", ",", "branch0", ",", " ", 
         "branch1", ",", "overlap", ",", " ", "pPlusX", ",", " ", "pPlusY", ",",
          "pBar", ",", " ", "xBar", ",", " ", "thetaTarget", ",", " ", "gain",
          ",", " ", "omegaReference", ",", "omegaFinite", ",", " ", 
         "finiteBias", ",", " ", "dcoCoefficient"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cache", " ", "=", " ", 
         RowBox[{"DGWScalingCache", "[", "d", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fourier", " ", "=", " ", 
         RowBox[{"cache", "[", "\"\<Fourier\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"psi", " ", "=", " ", 
