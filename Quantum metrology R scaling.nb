         "|>"}]}]}], "\n", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunVariableNCoefficientStudy", "[", 
      RowBox[{
      "nValues_List", ",", "dimensionFunction_", ",", "  ", 
       "nuListInput_List", ",", "\n", "    ", 
       RowBox[{"numTrials_Integer", "?", "Positive"}], ",", "  ", 
       RowBox[{"numInstances_Integer", "?", "Positive"}], ",", 
       "randomSeed_Integer", ",", "\n", "    ", 
       RowBox[{"pRange", " ", ":", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"_", "?", "NumericQ"}], ",", " ", 
