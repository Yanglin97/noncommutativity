        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "m"}], ",", " ", "m"}], "]"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"FROM", " ", "PREVIOUS", " ", "NOTEBOOK"}], ";", " ", 
     RowBox[{"CONTENT", " ", "UNCHANGED"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalLabel", "[", 
      RowBox[{"n_Integer", ",", " ", "d_Integer"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "m", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"CheckOddDimension", "[", "d", "]"}], ";", "\n", "  ", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"d", " ", "-", " ", "1"}], ")"}], "/", "2"}]}], ";", "\n", 
        "  ", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"n", " ", "+", " ", "m"}], ",", " ", "d"}], "]"}], " ", "-",
          " ", "m"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"FROM", " ", "PREVIOUS", " ", "NOTEBOOK"}], ";", " ", 
     RowBox[{"CONTENT", " ", "UNCHANGED"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"DGWFourierMatrixXToP", "[", "d_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "labels", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"CheckOddDimension", "[", "d", "]"}], ";", "\n", "  ", 
        RowBox[{"labels", " ", "=", " ", 
         RowBox[{"Labels", "[", "d", "]"}]}], ";", "\n", "  ", 
        RowBox[{"N", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "2", " ", "Pi", " ", "n", " ", 
              RowBox[{"k", "/", "d"}]}], "]"}], "/", 
            RowBox[{"Sqrt", "[", "d", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "labels"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "labels"}], "}"}]}], "]"}]}]}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"FROM", " ", "PREVIOUS", " ", "NOTEBOOK"}], ";", " ", 
     RowBox[{"CONTENT", " ", "UNCHANGED"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"DGWStateVectorXBasis", "[", 
      RowBox[{"d_Integer", ",", 
       RowBox[{"sigma_", "?", "NumericQ"}], ",", 
       RowBox[{"x0_", "?", "NumericQ"}], ",", 
       RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "m", ",", " ", "labels", ",", " ", "support", ",", " ", "psi", ",", 
         "nCanonical", ",", " ", "pos", ",", " ", "amp", ",", " ", "norm"}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"CheckOddDimension", "[", "d", "]"}], ";", "\n", "    ", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"d", " ", "-", " ", "1"}], ")"}], "/", "2"}]}], ";", "\n", 
        "    ", 
        RowBox[{"labels", " ", "=", " ", 
         RowBox[{"Labels", "[", "d", "]"}]}], ";", "\n", "    ", 
        RowBox[{"support", " ", "=", " ", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Floor", "[", "x0", "]"}], " ", "-", " ", "m"}], ",", " ", 
           RowBox[{
            RowBox[{"Floor", "[", "x0", "]"}], " ", "+", " ", "m"}]}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"psi", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"0.", " ", "+", " ", 
            RowBox[{"0.", " ", "I"}]}], ",", " ", "d"}], "]"}]}], ";", "\n", 
        "    ", 
        RowBox[{"Do", "[", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"nCanonical", " ", "=", " ", 
            RowBox[{"CanonicalLabel", "[", 
             RowBox[{"n", ",", " ", "d"}], "]"}]}], ";", "\n", "      ", 
           RowBox[{"pos", " ", "=", " ", 
            RowBox[{
             RowBox[{"FirstPosition", "[", 
              RowBox[{"labels", ",", " ", "nCanonical"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "      ", 
           RowBox[{"amp", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "Pi"}], " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"n", " ", "-", " ", "x0"}], ")"}], "^", "2"}], "/", 
                 RowBox[{"sigma", "^", "2"}]}]}], "]"}], "*", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "2", " ", "Pi", " ", "p0", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"n", " ", "-", " ", "x0"}], ")"}], "/", "d"}]}], 
               "]"}]}], " ", "]"}]}], ";", "\n", "      ", 
           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"[", "pos", "]"}], "]"}], " ", "+=", " ", "amp"}]}], ",",
           "\n", "      ", 
          RowBox[{"{", 
           RowBox[{"n", ",", " ", "support"}], "}"}]}], "\n", "    ", "]"}], ";",
         "\n", "    ", 
        RowBox[{"norm", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "psi"}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"psi", "/", "norm"}]}]}], "\n", "]"}]}], ";"}], 
   "\n"}]}]], "Input",
