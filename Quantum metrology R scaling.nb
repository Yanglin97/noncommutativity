   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"FROM", " ", "PREVIOUS", " ", "NOTEBOOK"}], ";", " ", 
     RowBox[{"CONTENT", " ", "UNCHANGED"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Labels", "[", "d_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "m", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"CheckOddDimension", "[", "d", "]"}], ";", "\n", "  ", 
