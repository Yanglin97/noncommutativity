Cell[CellGroupData[{

Cell["Variable-N simulation and fitting functions", "Section",ExpressionUUID->"6fcee55d-5234-854c-9bd1-4e087368a15d"],

Cell["\<\
All functions in the next cell aim for the present variable-N studies. In \
particular, the fast branch propagation, Monte Carlo estimator, \
random-instance averaging, bias-window selection, and log-log fitting code \
are not copied from the previous notebook.\
\>", "Text",
 CellChangeTimes->{{3.9974940208051815`*^9, 
  3.997494033830179*^9}},ExpressionUUID->"999b0412-6823-3a4d-b564-\
d0fe083ea03d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
