          RowBox[{"logData", ",", " ", "variable", ",", " ", "variable"}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"expression", " ", "=", " ", 
         RowBox[{"Normal", "[", "model", "]"}]}], ";", "\n", "  ", 
        RowBox[{"slope", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"Coefficient", "[", 
