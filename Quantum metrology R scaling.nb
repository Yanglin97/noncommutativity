Cell["Study 1: fixed d=65 and N=1,\[Ellipsis],8", "Section",ExpressionUUID->"0545cc52-9f37-9c43-a00b-361180e1ca7e"],

Cell["\<\
With p_j,x_j\[Element][0.4,0.6], the sufficient bulk condition gives \
(8/\[Pi])(0.6)^2 N^2\[TildeTilde]0.9167 N^2\[LessEqual]65 for N\[LessEqual]8.\
\>", "Text",ExpressionUUID->"9044df50-8fe6-8447-8ddd-29c91c16e94c"],

