                  RowBox[{"\"\<InitialEnergyRatio\>\"", "->", "energyRatio"}],
                   ",", 
                  RowBox[{"\"\<CoefficientRatioCheck\>\"", "->", 
                   RowBox[{"cDCOAtEICO", "/", 
                    RowBox[{"(", 
