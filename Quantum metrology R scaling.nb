Cell[CellGroupData[{

Cell["Initial-energy ratio R versus N", "Section",
 CellChangeTimes->{
  3.9975048624045086`*^9},ExpressionUUID->"8cf9a071-4fb1-774f-a213-\
0ef1cbe2629e"],

Cell["\<\
This is post-processing of the same d approximately N^2 data used in the \
current coefficient figure. For every N, the code evaluates E_ICO directly, \
writes the DCO Cramer-Rao coefficient as K_N/E_DCO, and solves K_N/E_DCO = \
c_N^ICO. The resulting R points are fitted directly on log-log axes. The \
equal-energy value R = 1 is drawn only as a horizontal dashed reference line, \
not as a second dataset. Thus the plotted R is a CR-implied necessary energy \
ratio, not the achieved energy of a constructed optimal DCO protocol. The \
value 1 below follows the notebook's literal per-quadrature coefficient \
convention; change it to 2 only if DCO is assigned the same total 2 nu \
physical shots used by the two ICO Ramsey quadratures.\
\>", "Text",ExpressionUUID->"cf211048-450a-f746-a361-d6fcd2a6bf26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Apply", " ", "the", " ", "energy"}], "-", 
    RowBox[{"ratio", " ", "post"}], "-", 
    RowBox[{
    "processing", " ", "to", " ", "the", " ", "completed", " ", "d", " ", 
     "approximately", " ", 
     RowBox[{"N", "^", "2"}], " ", "study", " ", "underlying", " ", "the", " ",
      "current", " ", 
     RowBox[{"Fig", ".", " ", "3."}], "\n", "   ", "Multiplier", " ", "1", " ",
      "implements", " ", "the", " ", "literal", " ", "coefficient", " ", 
     "equality", " ", "in", " ", "this", " ", 
     RowBox[{"notebook", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"energyRatioResult", " ", "=", " ", 
     RowBox[{"ComputeInitialEnergyRatioStudy", "[", 
      RowBox[{"quadraticResult", ",", 
       RowBox[{"\"\<DCORepetitionsPerNotebookNu\>\"", " ", "->", " ", "1"}]}],
       "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"energyRatioPlot", " ", "=", " ", 
     RowBox[{"PlotInitialEnergyRatioStudy", "[", 
      RowBox[{"energyRatioResult", ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<FrameLabel\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<N\>\"", ",", 
          " ", "\"\<CR-implied initial-energy ratio R\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<PlotLabel\>\"", " ", "->", " ", "None"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<FontSize\>\"", " ", "->", " ", "22"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<LegendPosition\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0.72", ",", " ", "0.25"}], "}"}]}]}], "\[IndentingNewLine]",
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", "energyRatioPlot", "\n", 
   RowBox[{"energyRatioResult", "[", "\"\<EnergyRatioDataset\>\"", "]"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.997504879679178*^9, 3.9975049453814964`*^9}, {
  3.9975050027379208`*^9, 3.9975050083907433`*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"af7d6cf7-e3e3-d54f-a08f-d0bd76d1fa64"],

