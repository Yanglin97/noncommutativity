   RowBox[{
    RowBox[{
     RowBox[{"CheckOddDimension", "[", "d_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
