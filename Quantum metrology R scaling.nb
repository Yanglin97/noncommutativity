Cell[CellGroupData[{

Cell["Energy-ratio post-processing", "Section",
 CellChangeTimes->{{3.997494002848982*^9, 
  3.9974940031997204`*^9}},ExpressionUUID->"ce73eebb-7a84-8447-8996-\
2405f70b8f87"],

Cell["\<\
ComputeInitialEnergyRatioStudy and PlotInitialEnergyRatioStudy reuse \
DGWScalingCache and FitLogLogData unchanged, do not rerun the Monte Carlo \
simulation, evaluate the ICO probe energy directly, solve the DCO Cramer-Rao \
coefficient for the energy required to match the fitted ICO coefficient, and \
retain an algebraic coefficient-ratio check. The plot uses logarithmic axes \
for both N and R, showing only the R data, its fitted power law, and a \
horizontal dashed R = 1 reference line.\
\>", "Text",
 CellChangeTimes->{{3.997493121804104*^9, 3.997493137483652*^9}, {
  3.997493986020178*^9, 
  3.997493996972027*^9}},ExpressionUUID->"8907d0a3-8e35-224c-95a4-\
6d0fc22b81a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"NEW", " ", "IN", " ", "THIS", " ", 
    RowBox[{"REVISION", ":", " ", 
     RowBox[{"initial", "-", 
      RowBox[{
      "energy", " ", "ratio", " ", "R", " ", "versus", " ", "N"}]}]}]}], 
   "            ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Reuses", " ", "DGWScalingCache", " ", "and", " ", "FitLogLogData", " ", 
    "from", " ", "the", " ", 
    RowBox[{"notebook", "."}]}], "      ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "ComputeInitialEnergyRatioStudy", ",", "PlotInitialEnergyRatioStudy"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ComputeInitialEnergyRatioStudy", "::", "missing"}], 
     "=", "\"\<The input association must contain SummaryData and RawResults \
from a completed variable-N study.\>\""}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ComputeInitialEnergyRatioStudy", "::", "few"}], 
     "=", "\"\<Fewer than two valid positive data points are available for \
the energy-ratio fit.\>\""}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "ComputeInitialEnergyRatioStudy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<DCORepetitionsPerNotebookNu\>\"", "->", "1"}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ComputeInitialEnergyRatioStudy", "[", 
      RowBox[{"result_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "requiredRowKeys", ",", "validSummaries", ",", "ratioSummaries", ",", 
         "ratioData", ",", "ratioFit", ",", "pearsonThreshold", ",", 
         "dcoShotMultiplier", ",", "rawResults"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Validate", " ", "input", " ", "association"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<SummaryData\>\"", ",", "\"\<RawResults\>\""}], 
              "}"}], ",", 
             RowBox[{
              RowBox[{"KeyExistsQ", "[", 
               RowBox[{"result", ",", "#"}], "]"}], "&"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"ComputeInitialEnergyRatioStudy", "::", "missing"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "\[IndentingNewLine]",
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"dcoShotMultiplier", "=", 
         RowBox[{
         "OptionValue", "[", "\"\<DCORepetitionsPerNotebookNu\>\"", "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"NumericQ", "[", "dcoShotMultiplier", "]"}]}], "||", 
           RowBox[{"dcoShotMultiplier", "<=", "0"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rawResults", "=", 
         RowBox[{"result", "[", "\"\<RawResults\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"requiredRowKeys", "=", 
         RowBox[{"{", 
          
          RowBox[{"\"\<N\>\"", ",", "\"\<d\>\"", ",", "\"\<ICOCoefficient\>\"",
            ",", "\"\<DCOCoefficient\>\""}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Select", " ", "valid", " ", "summary", " ", "rows"}], 
         "*)"}], 
        RowBox[{"validSummaries", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"result", "[", "\"\<SummaryData\>\"", "]"}], ",", 
           RowBox[{"Function", "[", 
            RowBox[{"row", ",", 
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"row", ",", "\"\<Valid\>\"", ",", "False"}], "]"}], 
               "]"}], "&&", 
              RowBox[{"AllTrue", "[", 
               RowBox[{"requiredRowKeys", ",", 
                RowBox[{
                 RowBox[{"KeyExistsQ", "[", 
                  RowBox[{"row", ",", "#"}], "]"}], "&"}]}], "]"}], "&&", 
              RowBox[{"IntegerQ", "[", 
               RowBox[{"row", "[", "\"\<d\>\"", "]"}], "]"}], "&&", 
              RowBox[{"OddQ", "[", 
               RowBox[{"row", "[", "\"\<d\>\"", "]"}], "]"}], "&&", 
              RowBox[{
               RowBox[{"row", "[", "\"\<d\>\"", "]"}], ">", "0"}], "&&", 
              RowBox[{"AllTrue", "[", 
               RowBox[{
                RowBox[{"Lookup", "[", 
                 RowBox[{"row", ",", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<ICOCoefficient\>\"", 
                    ",", "\"\<DCOCoefficient\>\""}], "}"}]}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
                  RowBox[{"TrueQ", "[", 
                   RowBox[{"#", ">", "0"}], "]"}]}], "&"}]}], "]"}]}]}], 
            "]"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Build", " ", "ratio", " ", "summaries"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"ratioSummaries", "=", 
         RowBox[{"Map", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"row", ",", "\[IndentingNewLine]", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "n", ",", "d", ",", "cICO", ",", "cDCOAtEICO", ",", "eICO", ",",
                  "dcoCRNumerator", ",", "eDCOMatching", ",", "energyRatio", ",",
                  "rawForN", ",", "validInstanceAnalyses", ",", "instances", ",",
                  "dcoCRNumerators"}], "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"n", "=", 
                 RowBox[{"row", "[", "\"\<N\>\"", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"d", "=", 
                 RowBox[{"row", "[", "\"\<d\>\"", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"cICO", "=", 
                 RowBox[{"row", "[", "\"\<ICOCoefficient\>\"", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"cDCOAtEICO", "=", 
                 RowBox[{"row", "[", "\"\<DCOCoefficient\>\"", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"rawForN", "=", 
                 RowBox[{"SelectFirst", "[", 
                  RowBox[{"rawResults", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#1", "[", "\"\<N\>\"", "]"}], "===", "n"}], 
                    "&"}], ",", 
                   RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"validInstanceAnalyses", "=", 
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"rawForN", "[", "\"\<Instances\>\"", "]"}], ",", 
                   RowBox[{
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"#1", ",", "\"\<Valid\>\"", ",", "False"}], "]"}],
                     "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"instances", "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"#1", "[", "\"\<Instance\>\"", "]"}], "&"}], 
                   ")"}], "/@", "validInstanceAnalyses"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Direct", " ", "evaluation", " ", "of"}], "<", 
                  RowBox[{
                   RowBox[{"X", "^", "2"}], "+", 
                   RowBox[{"P", "^", "2"}]}], ">", 
                  RowBox[{"for", " ", "the", " ", "DGW", " ", "probe"}]}], 
                 "*)"}], "\[IndentingNewLine]", 
                RowBox[{"eICO", "=", 
                 RowBox[{"N", "[", 
                  RowBox[{"Re", "[", 
                   RowBox[{
                    RowBox[{"DGWScalingCache", "[", "d", "]"}], 
                    "[", "\"\<ProbeEnergy\>\"", "]"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{
                  "Compute", " ", "K_N", " ", "directly", " ", "from", " ", 
                   "the", " ", "same", " ", "valid", " ", "displacement", " ", 
                   RowBox[{"instances", ".", "For"}], " ", "each", " ", 
                   "instance"}], ",", 
                  RowBox[{
                   RowBox[{"c_DCO", 
                    RowBox[{"(", "E", ")"}]}], "=", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"K_i", "/", "E"}], " ", "with", " ", "K_i"}], "=", 
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "pBar", "]"}], "^", "2"}], ",", 
                    RowBox[{
                    RowBox[{"Abs", "[", "xBar", "]"}], "^", "2"}]}], "]"}], "/", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"16", " ", 
                    RowBox[{"N", "^", "2"}]}], ")"}], "."}]}]}]}]}], "*)"}], 
                RowBox[{"dcoCRNumerators", "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "[", "\"\<PBar\>\"", "]"}], "]"}], "^", 
                    "2"}], ",", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "[", "\"\<XBar\>\"", "]"}], "]"}], "^", 
                    "2"}]}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"16", " ", 
                    RowBox[{"n", "^", "2"}]}], ")"}]}], "&"}], ")"}], "/@", 
                  "instances"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"dcoCRNumerator", "=", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"Mean", "[", 
                   RowBox[{"Log", "[", "dcoCRNumerators", "]"}], "]"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{
                  "Allocate", " ", "the", " ", "fitted", " ", "ICO", " ", 
                   "coefficient", " ", "c_N"}], ",", 
                  RowBox[{
                   RowBox[{"then", " ", "solve", " ", 
                    RowBox[{"K_N", "/", 
                    RowBox[{"(", 
                    RowBox[{"s", " ", "E_DCO"}], ")"}]}]}], "=", 
                   RowBox[{
                    RowBox[{"c_N", " ", "for", " ", "the", " ", "CR"}], "-", 
                    RowBox[{"implied", " ", "DCO", " ", 
                    RowBox[{"energy", "."}]}]}]}]}], "*)"}], 
                RowBox[{"eDCOMatching", "=", 
                 RowBox[{"dcoCRNumerator", "/", 
                  RowBox[{"(", 
                   RowBox[{"dcoShotMultiplier", " ", "cICO"}], ")"}]}]}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"energyRatio", "=", 
                 RowBox[{"eDCOMatching", "/", "eICO"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"<|", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"\"\<N\>\"", "->", "n"}], ",", 
                  RowBox[{"\"\<d\>\"", "->", "d"}], ",", 
                  RowBox[{"\"\<ICOCoefficient\>\"", "->", "cICO"}], ",", 
                  
                  RowBox[{"\"\<DCOCoefficientAtICOEnergy\>\"", "->", 
                   "cDCOAtEICO"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"\"\<ICOProbeEnergy\>\"", "->", "eICO"}], ",", 
