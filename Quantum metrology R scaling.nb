Cell[CellGroupData[{

Cell["Study 2: d\[TildeTilde]N\.b2 and N=1,\[Ellipsis],16", "Section",ExpressionUUID->"0d7bab1d-6d3a-c348-bd8b-f9461d009ec8"],

Cell["\<\
The DGW construction requires odd d. The function therefore uses the smallest \
odd integer not below N\.b2+1: d=N\.b2+1 for even N and d=N\.b2+2 for odd N. \
The ranges [0.4,0.6] make dimension prefactor 1 sufficient under the stated \
bulk bound.\
\>", "Text",ExpressionUUID->"fb963a93-1da3-6541-9e91-1d48d92e60da"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"quadraticResult", " ", "=", " ", 
    RowBox[{"RunQuadraticDimensionCoefficientStudy", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<NValues\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", " ", "16"}], "]"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<DimensionPrefactor\>\"", " ", "->", " ", "1."}], ",", "\n",
       "  ", 
      RowBox[{"\"\<PRange\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"0.4", ",", " ", "0.6"}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<XRange\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"0.4", ",", " ", "0.6"}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<PearsonThreshold\>\"", " ", "->", " ", "0.99"}], ",", "\n",
       "  ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "81192"}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"quadraticResult", "[", "\"\<CoefficientPlot\>\"", "]"}], "\n", 
 RowBox[{"quadraticResult", "[", "\"\<NuSlopeDiagnosticPlot\>\"", "]"}], "\n", 
 RowBox[{"quadraticResult", "[", "\"\<SummaryDataset\>\"", "]"}]}], "Input",
