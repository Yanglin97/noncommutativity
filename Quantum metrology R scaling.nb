               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], 
           ")"}], " ", "/@", " ", "data"}]}], ";", "\n", "  ", 
        RowBox[{"model", " ", "=", " ", 
