 InterpretationBox[
  RowBox[{"\<\"Energy ratio: log(R) = \"\>", "\[InvisibleSpace]", 
   TagBox[
    InterpretationBox[
     StyleBox["\<\"2.0363\"\>",
      ShowStringCharacters->False],
     2.036313476891503,
     AutoDelete->True],
    NumberForm[#, {7, 4}]& ], "\[InvisibleSpace]", "\<\" log(N) + \"\>", "\[InvisibleSpace]", 
   TagBox[
    InterpretationBox[
     StyleBox["\<\"-3.9421\"\>",
      ShowStringCharacters->False],
     -3.942126485262845,
     AutoDelete->True],
    NumberForm[#, {7, 4}]& ], "\[InvisibleSpace]", "\<\"; Pearson r = \"\>", "\[InvisibleSpace]", 
   TagBox[
    InterpretationBox[
     StyleBox["\<\"0.99797\"\>",
      ShowStringCharacters->False],
     0.9979666008403417,
     AutoDelete->True],
    NumberForm[#, {7, 5}]& ]}],
  SequenceForm["Energy ratio: log(R) = ", 
   NumberForm[2.036313476891503, {7, 4}], " log(N) + ", 
