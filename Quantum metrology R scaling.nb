        RowBox[{"yLog", " ", "=", " ", 
         RowBox[{"logData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"pearsonR", " ", "=", " ", 
