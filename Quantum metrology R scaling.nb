Cell[CellGroupData[{

Cell["Replot completed results without rerunning", "Section",ExpressionUUID->"2c507a29-cb3f-ad45-a26b-76c184d95aff"],

Cell["\<\
The following function uses only the ICO data, DCO data, fitted models, and \
summaries already stored in a completed result association. Changing its \
label or style options does not repeat the Monte Carlo simulation.\
\>", "Text",ExpressionUUID->"a630ef87-6643-1846-9528-978ac5efb906"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"NEW", ":", " ", 
    RowBox[{
    "redraw", " ", "a", " ", "completed", " ", "study", " ", "without", " ", 
     "repeating", " ", "any", " ", "Monte", " ", "Carlo", " ", 
     RowBox[{"work", ".", "\n", "   ", "This"}], " ", "function", " ", "only",
      " ", "reads", " ", "data", " ", "already", " ", "stored", " ", "in", " ",
      "the", " ", "result", " ", 
     RowBox[{"association", "."}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "PlotVariableNCoefficientStudy", "]"}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PlotVariableNCoefficientStudy", "::", "missing"}], " ", "=", 
     "\n", "  ", "\"\<The supplied result association is missing the required \
keys `1`.\>\""}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "PlotVariableNCoefficientStudy", "]"}], " ", "=",
      " ", 
     RowBox[{"{", "\n", "  ", 
      RowBox[{
       RowBox[{"\"\<CoefficientFrameLabel\>\"", " ", "->", " ", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{"\"\<N\>\"", ",", "\n", 
          "    ", "\"\<\\!\\(\\*SubscriptBox[\\(c\\), \\(N\\)]\\) in MSE \
\[TildeTilde] \\\n\\!\\(\\*SubscriptBox[\\(c\\), \\(N\\)]\\)/\[Nu]\>\""}], 
         "\n", "  ", "}"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<SlopeFrameLabel\>\"", " ", "->", " ", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{"\"\<N\>\"", ",", "\n", 
          "    ", "\"\<fitted \[Nu]-slope \\!\\(\\*SubscriptBox[\\(a\\), \\(N\
\\)]\\)\>\""}], "\n", "  ", "}"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<CoefficientPlotLabel\>\"", " ", "->", " ", "None"}], ",", 
       "\n", "  ", 
       RowBox[{"\"\<SlopePlotLabel\>\"", " ", "->", 
        " ", "\"\<Diagnostic: log MSE versus log \[Nu]\>\""}], ",", "\n", 
       "  ", 
       RowBox[{"\"\<ICOLegendLabel\>\"", " ", "->", 
        " ", "\"\<ICO Monte Carlo\>\""}], ",", "\n", "  ", 
       RowBox[{"\"\<DCOLegendLabel\>\"", " ", "->", 
        " ", "\"\<DCO asymptotic bound\>\""}], ",", "\n", "  ", 
       RowBox[{"\"\<ICOFitLegendPrefix\>\"", " ", "->", 
        " ", "\"\<ICO fit\>\""}], ",", "\n", "  ", 
       RowBox[{"\"\<DCOFitLegendPrefix\>\"", " ", "->", 
        " ", "\"\<DCO fit\>\""}], ",", "\n", "  ", 
       RowBox[{"\"\<LegendPosition\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0.73", ",", " ", "0.78"}], "}"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<FontSize\>\"", " ", "->", " ", "20"}], ",", "\n", "  ", 
       RowBox[{"\"\<ImageSize\>\"", " ", "->", " ", "Large"}]}], "\n", 
      "}"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PlotVariableNCoefficientStudy", "[", 
      RowBox[{"result_Association", ",", " ", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "requiredKeys", ",", " ", "missingKeys", ",", " ", "icoData", ",", 
         " ", "dcoData", ",", " ", "validSummaries", ",", "slopeData", ",", 
         " ", "icoFit", ",", " ", "dcoFit", ",", " ", "nVariable", ",", " ", 
         "nMin", ",", " ", "nMax", ",", "points", ",", "fittedLines", ",", 
         "legend", ",", "coefficientPlot", ",", "slopePlot", ",", 
         "legendFontSize", ",", "icoPointSample", ",", "dcoPointSample", ",", 
         "icoLineSample", ",", "dcoLineSample"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"requiredKeys", " ", "=", " ", 
         RowBox[{"{", "\[IndentingNewLine]", 
          
          RowBox[{"\"\<ICOData\>\"", ",", 
           "\[IndentingNewLine]", "\"\<DCOData\>\"", ",", 
           "\[IndentingNewLine]", "\"\<SummaryData\>\"", ",", 
           "\[IndentingNewLine]", "\"\<ICOLogCoefficientFit\>\"", ",", 
           "\[IndentingNewLine]", "\"\<DCOLogCoefficientFit\>\""}], 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"missingKeys", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"requiredKeys", ",", " ", 
           RowBox[{
            RowBox[{"MissingQ", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"result", ",", " ", "#"}], "]"}], "]"}], " ", "&"}]}], 
          " ", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"missingKeys", " ", "=!=", " ", 
           RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PlotVariableNCoefficientStudy", "::", "missing"}], ",", 
             " ", "missingKeys"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "\[IndentingNewLine]",
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"icoData", " ", "=", " ", 
         RowBox[{"result", "[", "\"\<ICOData\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dcoData", " ", "=", " ", 
         RowBox[{"result", "[", "\"\<DCOData\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"icoFit", " ", "=", " ", 
         RowBox[{"result", "[", "\"\<ICOLogCoefficientFit\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dcoFit", " ", "=", " ", 
         RowBox[{"result", "[", "\"\<DCOLogCoefficientFit\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"validSummaries", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"result", "[", "\"\<SummaryData\>\"", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationQ", "[", "#", "]"}], " ", "&&", " ", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", " ", "\"\<Valid\>\"", ",", " ", "False"}], 
               "]"}], "]"}]}], " ", "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"slopeData", " ", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", "\"\<N\>\"", "]"}], ",", " ", 
              RowBox[{"#", "[", "\"\<MeanNuSlope\>\"", "]"}]}], "}"}], " ", 
            "&"}], ")"}], " ", "/@", " ", "validSummaries"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nMin", " ", "=", " ", 
         RowBox[{"Min", "[", 
          RowBox[{"icoData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nMax", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"icoData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"points", " ", "=", " ", 
         RowBox[{"ListLogLogPlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"icoData", ",", " ", "dcoData"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{"Blue", ",", " ", 
                RowBox[{"PointSize", "[", "0.018", "]"}]}], "]"}], ",", 
              RowBox[{"Directive", "[", 
               RowBox[{"Red", ",", " ", 
                RowBox[{"PointSize", "[", "0.018", "]"}]}], "]"}]}], "}"}]}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"PlotMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "11"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledSquare]\>\"", ",", " ", "11"}], "}"}]}], 
             "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{
            "OptionValue", "[", "\"\<CoefficientFrameLabel\>\"", "]"}]}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"BaseStyle", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"FontSize", " ", "->", " ", 
              RowBox[{"OptionValue", "[", "\"\<FontSize\>\"", "]"}]}], 
             "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"ImageSize", " ", "->", " ", 
            RowBox[{"OptionValue", "[", "\"\<ImageSize\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotLabel", " ", "->", " ", 
            RowBox[{
            "OptionValue", "[", "\"\<CoefficientPlotLabel\>\"", "]"}]}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fittedLines", " ", "=", " ", 
         RowBox[{"LogLogPlot", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"icoFit", "[", "\"\<Prefactor\>\"", "]"}], " ", 
               RowBox[{"nVariable", "^", 
                RowBox[{"icoFit", "[", "\"\<Slope\>\"", "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"dcoFit", "[", "\"\<Prefactor\>\"", "]"}], " ", 
               RowBox[{"nVariable", "^", 
                RowBox[{"dcoFit", "[", "\"\<Slope\>\"", "]"}]}]}]}], "}"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"nVariable", ",", " ", "nMin", ",", " ", "nMax"}], "}"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{"Blue", ",", " ", "Dashed", ",", " ", "Thick"}], "]"}],
               ",", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{"Red", ",", " ", "Dashed", ",", " ", "Thick"}], 
               "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"legendFontSize", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"12", ",", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<FontSize\>\"", "]"}], "-", 
            "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"icoPointSample", "=", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Inset", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", "Blue", ",", "12"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0.5", ",", "0.5"}], "}"}]}], "]"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"38", ",", "15"}], "}"}]}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"15", "/", "38"}]}], ",", 
           RowBox[{"ImagePadding", "->", "0"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dcoPointSample", "=", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Inset", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<\[FilledSquare]\>\"", ",", "Red", ",", "12"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0.5", ",", "0.5"}], "}"}]}], "]"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"38", ",", "15"}], "}"}]}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"15", "/", "38"}]}], ",", 
           RowBox[{"ImagePadding", "->", "0"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"icoLineSample", "=", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Blue", ",", "Dashed", ",", 
               RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0.05", ",", "0.5"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0.95", ",", "0.5"}], "}"}]}], "}"}], "]"}]}], "}"}],
            ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", 
